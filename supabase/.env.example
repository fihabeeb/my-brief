# Copy to supabase/.env (git-ignored) and fill in.
# Apply with: supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# by the Edge Function runtime; do not put them here.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in Google Cloud.
OAUTH_REDIRECT_URL=https://<PROJECT_REF>.supabase.co/functions/v1/oauth-callback

# Shared with the Vault secret named email_sync_secret.
EMAIL_SYNC_SECRET=
